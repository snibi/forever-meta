---
import Base from '../../layouts/Base.astro';
import Badge from '../../components/Badge.astro';
import { getTierLists } from '../../lib/content';
import { href } from '../../lib/paths';

const ORDER = ['pvp-overall', 'pve-dps', 'pve-tank', 'pve-healer', 'leveling', 'racials'];
const lists = (await getTierLists()).sort((a, b) => ORDER.indexOf(a.id) - ORDER.indexOf(b.id));
---
<Base title="Tier lists" description="WoW Forever tier lists: PvP, PvE DPS/tank/healer, leveling and racials.">
  <h1 class="mb-2 text-4xl font-bold text-gold">Tier lists</h1>
  <p class="mb-8 max-w-2xl text-muted">Each list states the level and build it rests on. Tiers are synthesised from our 27 spec verdicts and cross-checked against published lists.</p>
  {lists.length === 0 ? (
    <p class="text-muted">Tier lists are being compiled.</p>
  ) : (
    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {lists.map((l) => (
        <a href={href(`/tier-lists/${l.id}/`)} class="card block p-4 no-underline transition hover:border-gold">
          <h2 class="mb-1 text-lg text-gold">{l.data.title}</h2>
          <p class="mb-3 text-sm text-muted">{l.data.description}</p>
          <div class="flex items-center justify-between gap-2">
            <Badge confidence={l.data.confidence} />
            <span class="text-xs text-muted">Updated {l.data.updatedOn}</span>
          </div>
        </a>
      ))}
    </div>
  )}
</Base>
