---
import { PVP } from '../lib/pvp';

interface Props {
  faction?: 'alliance' | 'horde' | 'both';
}
const { faction = 'both' } = Astro.props;
const fmt = (n: number) => n.toLocaleString('en-US');
---
<section aria-label="PvP rank path" class="card p-4">
  <div class="mb-3 flex flex-wrap items-center gap-2">
    <h3 class="text-base text-gold">PvP rank path</h3>
    <span class="rounded-full border border-violet-500/50 bg-violet-500/10 px-2 py-0.5 text-xs font-semibold text-violet-300">Datamined — beta</span>
    <a class="ml-auto text-xs text-muted underline" href={PVP.sourceUrl} rel="noopener">Icy Veins · {PVP.sourceDate}</a>
  </div>
  <div class="grid gap-6 lg:grid-cols-[1fr_16rem]">
    <ol class="divide-y divide-line/60 text-sm">
      {PVP.ranks.map((r) => (
        <li class="flex flex-wrap items-baseline gap-x-3 gap-y-0.5 py-1.5">
          <span class="w-8 shrink-0 font-display text-gold">R{r.rank}</span>
          <span class="w-56 shrink-0">
            {faction !== 'horde' && <span style="color:var(--color-alliance)">{r.alliance}</span>}
            {faction === 'both' && <span class="text-muted"> / </span>}
            {faction !== 'alliance' && <span style="color:var(--color-horde)">{r.horde}</span>}
          </span>
          <span class="text-xs text-muted w-24 shrink-0">{fmt(r.cumulativeRankPoints)} pts</span>
          <span class="flex-1 min-w-[10rem]">{r.rewards.join(' · ')}</span>
        </li>
      ))}
    </ol>
    <aside class="space-y-4 text-sm">
      <div>
        <h4 class="mb-1 font-display text-gold">Battlegrounds</h4>
        <ul class="space-y-1">
          {PVP.battlegrounds.map((b) => (
            <li class="flex justify-between gap-2"><span>{b.name} <span class="text-muted">{b.size}</span></span><span class="text-muted">L{b.minLevel}+</span></li>
          ))}
        </ul>
      </div>
      <div>
        <h4 class="mb-1 font-display text-gold">Limits</h4>
        <ul class="list-disc space-y-1 pl-4 text-muted">
          <li>Honor is capped at {fmt(PVP.honorCap)}.</li>
          <li>Weekly max rank: {PVP.weeklyRankCeiling.map((r, i) => `W${i + 1}${i === 9 ? '+' : ''}: R${r}`).join(', ')}.</li>
          {PVP.notes.map((n) => <li>{n}</li>)}
        </ul>
      </div>
    </aside>
  </div>
</section>
