---
interface Props {
  bis?: Array<{ slot: string; item: string; wowheadItemId?: number; sourceId: string }>;
}
const { bis } = Astro.props;
---
{bis && bis.length > 0 && (
  <div class="card overflow-x-auto">
    <table class="w-full text-left text-sm">
      <thead class="bg-raised text-xs uppercase tracking-wider text-muted">
        <tr><th class="px-3 py-2">Slot</th><th class="px-3 py-2">Item</th></tr>
      </thead>
      <tbody class="divide-y divide-line">
        {bis.map((b) => (
          <tr>
            <td class="px-3 py-2 text-muted">{b.slot}</td>
            <td class="px-3 py-2">
              {b.wowheadItemId ? (
                <a class="text-gold underline" href={`https://www.wowhead.com/forever/item=${b.wowheadItemId}`} rel="noopener">{b.item}</a>
              ) : b.item}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
)}
