---
import type { Role } from '../lib/classes';

interface Props {
  role: Role;
}
const { role } = Astro.props;
---
<svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true" class="shrink-0 text-muted">
  {role === 'tank' && <path fill="currentColor" d="M8 1.4 3.2 3.4v4.1c0 3.1 2 5.4 4.8 6.6 2.8-1.2 4.8-3.5 4.8-6.6V3.4L8 1.4Z" />}
  {role === 'healer' && <path fill="currentColor" d="M7 2h2v4h4v2H9v4H7V8H3V6h4V2Z" />}
  {role === 'melee' && <path fill="currentColor" d="m2.4 12.2 3.9-3.9 1.4 1.4-3.9 3.9-1.4-1.4Zm6.7-5.3 4.2-4.2 1.3 1.3-4.2 4.2-1.3-1.3ZM9.6 3.4l1.2-1.2 3 3-1.2 1.2-3-3ZM3.4 9.6l3 3-1.2 1.2-3-3 1.2-1.2Z" />}
  {role === 'ranged' && <path fill="currentColor" d="M8 1.2 9.5 6.5 14.8 8 9.5 9.5 8 14.8 6.5 9.5 1.2 8l5.3-1.5L8 1.2Z" />}
</svg>
