---
import meta from '../data/meta.json';
const label = new Date(meta.launchAt).toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC',
});
---
<p class="font-display text-lg tracking-wide text-gold" id="countdown" data-launch={meta.launchAt} aria-live="off">
  <noscript>Launches {label} · 15:00 PST</noscript>
</p>
<script>
  const el = document.getElementById('countdown');
  if (el) {
    const target = Date.parse(el.dataset.launch!);
    const tick = () => {
      const ms = target - Date.now();
      if (ms <= 0) {
        el.textContent = 'Live now';
        return false;
      }
      const s = Math.floor(ms / 1000);
      const d = Math.floor(s / 86400);
      const h = Math.floor((s % 86400) / 3600);
      const m = Math.floor((s % 3600) / 60);
      el.textContent = `Launch in ${d}d ${h}h ${m}m ${s % 60}s`;
      return true;
    };
    if (tick()) {
      const id = setInterval(() => {
        if (!tick()) clearInterval(id);
      }, 1000);
    }
  }
</script>
