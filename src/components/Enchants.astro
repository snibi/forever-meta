---
import Badge from './Badge.astro';

interface Props {
  enchants: Array<{ slot: string; name: string; note?: string; evidence: string }>;
}
const { enchants } = Astro.props;
---
{enchants.length > 0 && (
  <div class="card overflow-x-auto">
    <table class="w-full text-left text-sm">
      <thead class="bg-raised text-xs uppercase tracking-wider text-muted">
        <tr><th class="px-3 py-2">Slot</th><th class="px-3 py-2">Enchant</th><th class="px-3 py-2">Evidence</th></tr>
      </thead>
      <tbody class="divide-y divide-line">
        {enchants.map((e) => (
          <tr>
            <td class="px-3 py-2 text-muted whitespace-nowrap">{e.slot}</td>
            <td class="px-3 py-2"><span class="font-medium">{e.name}</span>{e.note && <span class="block text-xs text-muted">{e.note}</span>}</td>
            <td class="px-3 py-2"><Badge evidence={[e.evidence]} /></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
)}
