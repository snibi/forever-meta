---
import icons from '../data/icons.json';
import { href } from '../lib/paths';
interface Props {
  name: string;
  size?: number;
  alt?: string;
  class?: string;
  style?: string;
}
const { name, size = 40, alt = '', class: cls = '', style } = Astro.props;
const available = new Set<string>(icons);
const file = available.has(name) ? name : 'inv_misc_questionmark';
---
<img
  src={href(`/icons/${file}.jpg`)}
  width={size}
  height={size}
  alt={alt}
  loading="lazy"
  decoding="async"
  class:list={['rounded-md border border-[#8a8070] bg-[#2a3142] object-cover shrink-0 shadow-[inset_0_0_0_1px_rgba(0,0,0,0.65)]', cls]}
  style={style}
/>
