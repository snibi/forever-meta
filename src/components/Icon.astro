---
import icons from '../data/icons.json';
import { href } from '../lib/paths';
interface Props {
  name: string;
  size?: number;
  alt?: string;
  class?: string;
  style?: string;
}
const { name, size = 40, alt = '', class: cls = '', style } = Astro.props;
const available = new Set<string>(icons);
const file = available.has(name) ? name : 'inv_misc_questionmark';
---
<img
  src={href(`/icons/${file}.jpg`)}
  width={size}
  height={size}
  alt={alt}
  loading="lazy"
  decoding="async"
  class:list={['rounded-md border border-line bg-raised object-cover shrink-0', cls]}
  style={style}
/>
