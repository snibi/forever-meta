---
import Icon from './Icon.astro';
import { specById, textColor } from '../lib/classes';
import { treeIcon } from '../lib/talents';
import { specHref, type TierListEntry } from '../lib/content';
import { uniqueRacials } from '../lib/races';

interface Props {
  list: TierListEntry['data'];
  onlyTiers?: string[];
}
const { list, onlyTiers } = Astro.props;
const racials = new Map(uniqueRacials().map((r) => [r.name, r]));
const COLOR: Record<string, string> = {
  S: 'var(--color-tier-s)',
  A: 'var(--color-tier-a)',
  B: 'var(--color-tier-b)',
  C: 'var(--color-tier-c)',
  D: 'var(--color-tier-d)',
};
const mode = list.scope === 'pvp' || list.scope === 'pve' || list.scope === 'leveling' ? list.scope : undefined;
const tiers = list.tiers.filter((t) => !onlyTiers || onlyTiers.includes(t.tier));
---
<div class="card divide-y divide-line overflow-hidden">
  {tiers.map((tier) => (
    <div class="flex" data-tier={tier.tier}>
      <div
        class="flex w-14 shrink-0 items-center justify-center font-display text-2xl font-bold text-black sm:w-20 sm:text-3xl"
        style={`background:${COLOR[tier.tier]}`}
      >{tier.tier}</div>
      <ul class="flex min-h-16 flex-1 flex-wrap items-center gap-2 p-3">
        {tier.entries.length === 0 && <li class="text-sm text-muted">—</li>}
        {tier.entries.map((e) => {
          const spec = specById(e.ref);
          const racial = racials.get(e.ref);
          return (
            <li class="tip-host" data-chip>
              {spec ? (
                <a class="chip" style={`--chip-color:${spec.color}`} href={specHref(spec, mode)}>
                  <Icon name={treeIcon(spec.class, spec.tree)} size={26} alt="" />
                  <span style={`color:${textColor(spec.color)}`}>{spec.name}</span>
                </a>
              ) : (
                <span class="chip" tabindex="0">
                  <Icon name={racial?.icon ?? 'inv_misc_questionmark'} size={26} alt="" />
                  {e.ref}
                </span>
              )}
              <div class="tip" role="tooltip">{e.note}</div>
            </li>
          );
        })}
      </ul>
    </div>
  ))}
</div>
